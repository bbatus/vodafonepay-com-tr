# --- CMS stack (docker-compose) ---
POSTGRES_DB=vodafonepaycms
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload

MINIO_ROOT_USER=payload
MINIO_ROOT_PASSWORD=payload-minio-secret
S3_BUCKET=vodafonepaycomtr-media

PAYLOAD_SECRET=dev-payload-secret-change-me

# Shared between the site (verifies incoming webhooks) and the CMS (signs them)
REVALIDATE_SECRET=dev-revalidate-secret

# --- Site ---
SITE_URL=http://localhost:3000
# Inside docker-compose the site reaches the CMS via the service name; from
# the host (e.g. `npm run dev` outside Docker) use http://localhost:3010/api
CMS_API_URL=http://cms:3000/api
