# Postgres connection used by Payload
DATABASE_URI=postgres://payload:payload@postgres:5432/vodafonepaycms

# Long random string — required by Payload for signing sessions/JWTs.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The main site, used for CORS/CSRF allow-listing and revalidate webhooks
SITE_URL=http://localhost:3000
SITE_REVALIDATE_URL=http://app:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-with-the-site

# MinIO (S3-compatible) — media storage
# S3_ENDPOINT is used server-side (container-to-container); S3_PUBLIC_URL is
# what gets baked into file URLs sent to browsers, so it must be reachable
# from the host machine, not just from inside the Docker network.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vodafonepaycomtr-media
S3_ACCESS_KEY_ID=payload
S3_SECRET_ACCESS_KEY=change-me-minio-secret
